# ==============================================================================
# RAINSHIELD AI — AI-Powered Integrated Rainfall & Flood Early Warning System
# SIH 2026 Prototype (Problem Statement ID: 26071)
# ==============================================================================

# Frontend API Configuration
VITE_API_URL=http://localhost:8000

# Backend Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# Database Configuration (SQLite default for zero-config demo; PostgreSQL supported)
DATABASE_URL=sqlite:///./rainshield.db

# Authentication Security
JWT_SECRET=rainshield-super-secret-sih2026-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI/ML Model Artifact Paths
MODEL_PATH=./app/ml/checkpoints
RAINFALL_MODEL_NAME=RainfallPredictor-v1.0
FLOOD_MODEL_NAME=FloodPredictor-v1.0

# External Meteorological Feeds & Endpoints (Optional external live sync)
RADAR_API_URL=https://imd.gov.in/radar/pune
SATELLITE_API_URL=https://mosdac.gov.in/insat3dr
NWP_API_URL=https://ncmrwf.gov.in/wrf
RIVER_GAUGE_API_URL=https://cwc.gov.in/telemetry/mula-mutha

# Map GIS Configuration
VITE_MAP_DEFAULT_LAT=18.5204
VITE_MAP_DEFAULT_LON=73.8567
VITE_MAP_DEFAULT_ZOOM=12
